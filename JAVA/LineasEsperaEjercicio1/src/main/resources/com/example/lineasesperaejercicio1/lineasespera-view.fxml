<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.lineasesperaejercicio1.Controller">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>
    <children>
        <VBox prefWidth="250.0" spacing="10.0">
            <children>
                <Label text="Tasa de Llegada (Lambda):" />
                <TextField fx:id="txtLambda" promptText="ej. 2.0" />
                <Label text="Tasa de Servicio (Mu):" />
                <TextField fx:id="txtMu" promptText="ej. 3.0" />
                <Label text="Número de Clientes:" />
                <TextField fx:id="txtClientes" promptText="ej. 100" />
                <Button onAction="#onSimularButtonClick" prefWidth="250.0" text="Simular" />
                <TextArea fx:id="txtResultados" editable="false" prefHeight="220.0" wrapText="true" />
            </children>
        </VBox>
        <BarChart fx:id="chartFrecuencias" prefWidth="500.0" title="Tiempo de Espera por Cliente">
            <xAxis>
                <CategoryAxis label="Cliente" />
            </xAxis>
            <yAxis>
                <NumberAxis label="Tiempo (min)" />
            </yAxis>
        </BarChart>
    </children>
</HBox>