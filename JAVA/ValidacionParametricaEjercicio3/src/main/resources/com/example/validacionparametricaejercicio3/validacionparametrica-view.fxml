<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.ScatterChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="500.0" prefWidth="780.0" spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.validacionparametricaejercicio3.Controller">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    <children>
        <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
            <tabs>
                <Tab text="Prueba Paramétrica (Prueba t)">
                    <content>
                        <VBox spacing="15.0">
                            <padding>
                                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                            </padding>
                            <children>
                                <HBox spacing="15.0">
                                    <children>
                                        <VBox prefWidth="220.0" spacing="8.0">
                                            <children>
                                                <Label text="Media Teórica (μ0):" />
                                                <TextField fx:id="txtMediaTeorica" promptText="ej. 50.0" />
                                                <Label text="Desviación Estándar (σ):" />
                                                <TextField fx:id="txtDesviacion" promptText="ej. 5.0" />
                                                <Label text="Tamaño Muestra (n):" />
                                                <TextField fx:id="txtMuestra" promptText="ej. 40" />
                                                <Button onAction="#onValidarButtonClick" prefWidth="220.0" text="Ejecutar Prueba" />
                                            </children>
                                        </VBox>
                                        <TextArea fx:id="txtResultados" editable="false" prefHeight="200.0" prefWidth="480.0" wrapText="true" HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </content>
                </Tab>
                <Tab text="Gráfica de Dispersión">
                    <content>
                        <ScatterChart fx:id="chartScatter" title="Distribución de Muestras Simuladas">
                            <xAxis>
                                <NumberAxis label="Número de Muestra" />
                            </xAxis>
                            <yAxis>
                                <NumberAxis label="Valor Observado" />
                            </yAxis>
                        </ScatterChart>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </children>
</VBox>